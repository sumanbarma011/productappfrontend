pipeline {
    agent any
    stages {
        stage ("clone github") {
            steps {
                git branch:"dev",credentialsId:"github", url:"https://github.com/sumanbarma011/productappfrontend.git"
            }
        }
        stage ("create docker image") {
            steps {
                sh "docker build -t productfrontend -f Dockerfiledev ."
            }
        }
        stage ("login to docker hub and push docker image") {
            steps {
                
                withCredentials ([usernamePassword(credentialsId: "dockerhub", usernameVariable: "user", passwordVariable: "password")]) {
                    sh "docker tag productfrontend ${env.user}/productfrontend:dev"
                    sh "docker login -u ${env.user} -p ${env.password}"
                    sh "docker push ${env.user}/productfrontend:dev"
                    
                }
            }
        }
